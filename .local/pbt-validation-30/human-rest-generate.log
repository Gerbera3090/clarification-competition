│     >>> fizz_buzz(50)                                                        │
│     0                                                                        │
│     >>> fizz_buzz(78)                                                        │
│     2                                                                        │
│     >>> fizz_buzz(79)                                                        │
│     3                                                                        │
│     """                                                                      │
│     if n <= 0:                                                               │
│         return 0                                                             │
│                                                                              │
│     count = 0                                                                │
│     for num in range(n):                                                     │
│         if num % 11 == 0 or num % 13 == 0:                                   │
│             count += str(num).count('7')                                     │
│     return count                                                             │
│ ```                                                                          │
