│     result = arr[:]                                                          │
│     gap = n // 2                                                             │
│                                                                              │
│     while gap > 0:                                                           │
│         for i in range(gap, n):                                              │
│             temp = result                                                    │
│             j = i                                                            │
│             while j >= gap and result > temp:                                │
│                 result = result                                              │
│                 j -= gap                                                     │
│             result = temp                                                    │
│         gap //= 2                                                            │
│                                                                              │
│     return result                                                            │
│ ```                                                                          │
