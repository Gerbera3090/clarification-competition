│ import heapq                                                                 │
│                                                                              │
│ def find_minimum_range(arrays):                                              │
│     k = len(arrays)                                                          │
│     # Initialize the heap with the first element of each array along with    │
│ array index and element index                                                │
│     heap = []                                                                │
│     current_max = float('-inf')                                              │
│                                                                              │
│     for i in range(k):                                                       │
│         val = arrays[0]                                                      │
│         heapq.heappush(heap, (val, i, 0))                                    │
│         if val > current_max:                                                │
│             current_max = val                                                │
│                                                                              │
│     min_range = float('inf')                                                 │
│     start, end = -1, -1                                                      │
│                                                                              │
│     while True:                                                              │
│         current_min, arr_idx, ele_idx = heapq.heappop(heap)                  │
│                                                                              │
│         # Update the range if it is smaller                                  │
│         if current_max - current_min < min_range:                            │
│             min_range = current_max - current_min                            │
│             start, end = current_min, current_max                            │
│                                                                              │
│         # If there is next element in the same array, add it to the heap     │
│         if ele_idx + 1 < len(arrays):                                        │
│             next_val = arrays                                                │
│             heapq.heappush(heap, (next_val, arr_idx, ele_idx + 1))           │
│             if next_val > current_max:                                       │
│                 current_max = next_val                                       │
│         else:                                                                │
│             # One of the arrays is exhausted, can't find better range        │
│             break                                                            │
