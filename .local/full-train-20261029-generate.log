│                                                                              │
│     Returns:                                                                 │
│         int: The nth Newman–Shanks–Williams prime number.                    │
│     """                                                                      │
│     def is_prime(num):                                                       │
│         if num < 2:                                                          │
│             return False                                                     │
│         if num in (2, 3):                                                    │
│             return True                                                      │
│         if num % 2 == 0 or num % 3 == 0:                                     │
