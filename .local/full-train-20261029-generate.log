│ def sum_of_alternates(chain):                                                │
│     sum_even = 0                                                             │
│     sum_odd = 0                                                              │
│     for i, (a, b) in enumerate(chain):                                       │
│         if i % 2 == 0:                                                       │
│             sum_even += a + b                                                │
│         else:                                                                │
│             sum_odd += a + b                                                 │
│     return sum_even, sum_odd                                                 │
