│ def is_num_keith(n: int) -> bool:                                            │
│     if n <= 0:                                                               │
│         return False                                                         │
│                                                                              │
│     digits = list(map(int, str(n)))                                          │
│     length = len(digits)                                                     │
│     terms = digits.copy()                                                    │
│                                                                              │
│     while terms[-1] < n:                                                     │
│         next_term = sum(terms[-length:])                                     │
│         terms.append(next_term)                                              │
│                                                                              │
