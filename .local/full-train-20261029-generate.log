│ from collections import Counter                                              │
│ import heapq                                                                 │
│                                                                              │
│ def rearange_string(s: str) -> bool:                                         │
│     if not s:                                                                │
│         return True                                                          │
│                                                                              │
│     count = Counter(s)                                                       │
│     max_count = max(count.values())                                          │
│                                                                              │
│     # If the count of any character is more than half the length rounded up, │
│     # it's impossible to rearrange without two identical adjacent chars.     │
│     if max_count > (len(s) + 1) // 2:                                        │
│         return False                                                         │
│                                                                              │
│     # Use a max heap to try to build a valid rearrangement                   │
│     max_heap = [(-freq, char) for char, freq in count.items()]               │
│     heapq.heapify(max_heap)                                                  │
│                                                                              │
│     prev_char = None                                                         │
│     prev_freq = 0                                                            │
│                                                                              │
│     while max_heap or prev_freq < 0:                                         │
│         if not max_heap and prev_freq < 0:                                   │
│             # No characters left to prevent adjacent duplicates              │
│             return False                                                     │
│                                                                              │
│         freq, char = heapq.heappop(max_heap)                                 │
│         # Append char to result (not required, but for logic)                │
│         freq += 1  # Use one occurrence                                      │
│                                                                              │
│         if prev_freq < 0:                                                    │
│             heapq.heappush(max_heap, (prev_freq, prev_char))                 │
│                                                                              │
│         prev_char = char                                                     │
│         prev_freq = freq                                                     │
│                                                                              │
│     return True                                                              │
│ ```                                                                          │
