│ def hamming_Distance(x: int, y: int) -> int:                                 │
│     # Find the number of bits needed to represent both numbers in two's      │
│ complement                                                                   │
│     # Consider sign bits for negative numbers                                │
│     max_bits = max(x.bit_length(), y.bit_length()) + 1  # +1 for sign bit    │
│                                                                              │
│     # Mask to get two's complement representation with max_bits bits         │
│     mask = (1 << max_bits) - 1                                               │
│                                                                              │
│     # XOR the masked values to find differing bits                           │
│     xor = (x & mask) ^ (y & mask)                                            │
│                                                                              │
│     # Count the number of set bits (Hamming distance)                        │
│     return bin(xor).count('1')                                               │
│ ```                                                                          │
