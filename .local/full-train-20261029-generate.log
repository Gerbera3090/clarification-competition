│ def parabola_directrix(a, b, c):                                             │
│     """                                                                      │
│     Given a parabola in standard form y = ax^2 + bx + c (a != 0),            │
│     return the equation of the directrix in the form y = k.                  │
│                                                                              │
│     The vertex is at x = -b/(2a), y = c - b^2/(4a).                          │
│     The focus is at (h, k + 1/(4a)) where h = -b/(2a), k = vertex_y.         │
│     The directrix is a horizontal line y = k - 1/(4a).                       │
│                                                                              │
│     Parameters:                                                              │
│         a (float): quadratic coefficient (non-zero)                          │
│         b (float): linear coefficient                                        │
│         c (float): constant term                                             │
│                                                                              │
│     Returns:                                                                 │
│         float: y-coordinate of the directrix line                            │
│     """                                                                      │
│     if a == 0:                                                               │
│         raise ValueError("Coefficient 'a' must be non-zero for a parabola.") │
│                                                                              │
│     h = -b / (2 * a)                                                         │
│     k = c - (b ** 2) / (4 * a)                                               │
│     directrix_y = k - 1 / (4 * a)                                            │
│     return directrix_y                                                       │
│ ```                                                                          │
