╭─────────────────────────────── Model Response ───────────────────────────────╮
│ ```python                                                                    │
│ def count_Rectangles(radius: int) -> int:                                    │
│     """                                                                      │
│     Count the number of axis-aligned rectangles with integer coordinates     │
│     that can fit inside or on the boundary of a circle centered at (0,0)     │
│     with given radius.                                                       │
│                                                                              │
│     Each rectangle is defined by two distinct x-coordinates and two distinct │
│ y-coordinates,                                                               │
│     all integers, such that all four corners lie inside or on the circle x^2 │
│ + y^2 <= radius^2.                                                           │
│                                                                              │
│     Parameters:                                                              │
│     radius (int): The radius of the circle.                                  │
│                                                                              │
│     Returns:                                                                 │
│     int: The number of such rectangles.                                      │
│     """                                                                      │
│     # First, find all integer points within the circle                       │
│     points = []                                                              │
│     for x in range(-radius, radius + 1):                                     │
│         max_y = int((radius**2 - x**2)**0.5)                                 │
│         for y in range(-max_y, max_y + 1):                                   │
│             points.append((x, y))                                            │
│                                                                              │
│     # Group points by their x-coordinate for quick lookup of available y's   │
│     from collections import defaultdict                                      │
│     x_to_ys = defaultdict(list)                                              │
│     for x, y in points:                                                      │
│         x_to_ys.append(y)                                                    │
│                                                                              │
│     # Sort y lists for each x                                                │
│     for x in x_to_ys:                                                        │
│         x_to_ys.sort()                                                       │
│                                                                              │
│     xs = sorted(x_to_ys.keys())                                              │
│     rectangle_count = 0                                                      │
│                                                                              │
│     # For each pair of distinct x's, count how many pairs of y's they share  │
│     # Each pair of y's defines the top and bottom edges of a rectangle       │
│     for i in range(len(xs)):                                                 │
│         for j in range(i+1, len(xs)):                                        │
│             x1, x2 = xs, xs                                                  │
│             ys1 = x_to_ys                                                    │
│             ys2 = x_to_ys                                                    │
│                                                                              │
│             # Find common ys                                                 │
│             # Since ys1 and ys2 are sorted, use two pointers to find         │
│ intersection                                                                 │
│             p1, p2 = 0, 0                                                    │
│             common_ys = []                                                   │
│             while p1 < len(ys1) and p2 < len(ys2):                           │
│                 if ys1 == ys2:                                               │
│                     common_ys.append(ys1)                                    │
│                     p1 += 1                                                  │
│                     p2 += 1                                                  │
│                 elif ys1 < ys2:                                              │
│                     p1 += 1                                                  │
│                 else:                                                        │
│                     p2 += 1                                                  │
│                                                                              │
│             # Number of rectangles formed by these two x's:                  │
│             # number of ways to pick 2 distinct y's from common_ys           │
│             n = len(common_ys)                                               │
│             if n >= 2:                                                       │
│                 rectangle_count += n * (n - 1) // 2                          │
│                                                                              │
│     return rectangle_count                                                   │
│ ```                                                                          │
