│ def lps(s: str) -> str:                                                      │
│     n = len(s)                                                               │
│     dp = [[0] * n for _ in range(n)]                                         │
│                                                                              │
│     for i in range(n):                                                       │
│         dp = 1                                                               │
│                                                                              │
│     for length in range(2, n+1):                                             │
│         for i in range(n-length+1):                                          │
│             j = i + length - 1                                               │
│             if s == s:                                                       │
│                 dp = 2 + (dp if i+1 <= j-1 else 0)                           │
│             else:                                                            │
│                 dp = max(dp, dp)                                             │
│                                                                              │
│     # Reconstruct the longest palindromic subsequence                        │
│     i, j = 0, n-1                                                            │
│     res = []                                                                 │
│     while i <= j:                                                            │
│         if s == s:                                                           │
│             res.append(s)                                                    │
│             i += 1                                                           │
│             j -= 1                                                           │
│         elif dp > dp:                                                        │
│             i += 1                                                           │
│         else:                                                                │
│             j -= 1                                                           │
│                                                                              │
│     # res contains the first half (and middle if length is odd)              │
│     # Construct the full palindrome                                          │
│     half = ''.join(res)                                                      │
│     if dp[0] % 2 == 0:                                                       │
│         return half + half[::-1]                                             │
│     else:                                                                    │
│         return half + half[-2::-1]                                           │
│ ```                                                                          │
