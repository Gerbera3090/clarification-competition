│ def prime_length(s: str) -> bool:                                            │
│     """Return True if the length of the input string s is a prime number,    │
│ else False."""                                                               │
│     n = len(s)                                                               │
│     if n < 2:                                                                │
│         return False                                                         │
│     if n == 2:                                                               │
│         return True                                                          │
│     if n % 2 == 0:                                                           │
│         return False                                                         │
│     for i in range(3, int(n**0.5) + 1, 2):                                   │
│         if n % i == 0:                                                       │
│             return False                                                     │
│     return True                                                              │
│ ```                                                                          │
