│ ```python                                                                    │
│ def is_woodall(n: int) -> bool:                                              │
│     if n <= 0:                                                               │
│         return False                                                         │
│     # A Woodall number is of the form n * 2^n - 1 for some positive integer  │
│ n                                                                            │
│     # We need to check if there exists an integer k such that:               │
│     # n = k * 2^k - 1                                                        │
│     # Rearranged: n + 1 = k * 2^k                                            │
│     # So we try values of k to see if k * 2^k == n + 1                       │
│                                                                              │
│     x = n + 1                                                                │
│     k = 1                                                                    │
│     while k * (2 ** k) <= x:                                                 │
│         if k * (2 ** k) == x:                                                │
│             return True                                                      │
│         k += 1                                                               │
│     return False                                                             │
│ ```                                                                          │
