│ distinct integers.                                                           │
│     The number of rotations is defined as the index of the smallest element, │
│     which is also the index of the largest element in the array.             │
│                                                                              │
│     Parameters:                                                              │
│     arr (list of int): A circularly sorted array of distinct integers.       │
│                                                                              │
│     Returns:                                                                 │
│     int: The number of rotations (index of the smallest element).            │
│     """                                                                      │
│     if not arr:                                                              │
│         return 0  # Empty array, no rotations                                │
│                                                                              │
│     low, high = 0, len(arr) - 1                                              │
│                                                                              │
│     # If array is not rotated at all                                         │
│     if arr < arr:                                                            │
│         return 0                                                             │
│                                                                              │
│     while low <= high:                                                       │
│         mid = (low + high) // 2                                              │
│                                                                              │
│         # Check if mid element is the smallest                               │
│         # If mid is smaller than previous element, mid is the smallest       │
│         if mid > 0 and arr < arr:                                            │
│             return mid                                                       │
│                                                                              │
│         # If mid element is greater than next element, next element is       │
│ smallest                                                                     │
│         if mid < len(arr) - 1 and arr > arr:                                 │
│             return mid + 1                                                   │
│                                                                              │
│         # Decide whether to go to left half or right half                    │
│         if arr >= arr:                                                       │
│             # Left part is sorted, so go right                               │
│             low = mid + 1                                                    │
│         else:                                                                │
│             # Right part is sorted, go left                                  │
│             high = mid - 1                                                   │
│                                                                              │
│     return 0  # Default, no rotation found                                   │
│                                                                              │
│ # Example usage and test                                                     │
│ if __name__ == "__main__":                                                   │
│     arrays = [                                                               │
│         [15, 18, 2, 3, 6, 12],   # rotated 2 times                           │
│         [7, 9, 11, 12, 5],       # rotated 4 times                           │
│         [1, 2, 3, 4, 5],         # rotated 0 times                           │
│         [4, 5, 1, 2, 3],         # rotated 2 times                           │
│         [3, 4, 5, 1, 2],         # rotated 3 times                           │
│     ]                                                                        │
│                                                                              │
│     for arr in arrays:                                                       │
│         rotations = find_rotation_count(arr)                                 │
│         print(f"Array: {arr} -> Rotations: {rotations}")                     │
│ ```                                                                          │
