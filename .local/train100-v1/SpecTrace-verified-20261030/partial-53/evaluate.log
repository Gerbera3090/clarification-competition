│     """                                                                      │
│     low, high = 0, len(arr) - 1                                              │
│                                                                              │
│     while low < high:                                                        │
│         mid = (low + high) // 2                                              │
│         if arr > arr:                                                        │
│             low = mid + 1                                                    │
│         else:                                                                │
│             high = mid                                                       │
