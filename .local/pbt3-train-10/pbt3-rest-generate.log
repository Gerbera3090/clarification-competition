╭─────────────────────────────── Model Response ───────────────────────────────╮
│ ```python                                                                    │
│ def get_maxgold(grid):                                                       │
│     if not grid or not grid[0]:                                              │
│         return 0                                                             │
│     rows, cols = len(grid), len(grid[0])                                     │
│     # dp will store max gold collectable starting from cell (i,j)            │
│     dp = [[0]*cols for _ in range(rows)]                                     │
│                                                                              │
│     for j in range(cols-1, -1, -1):                                          │
│         for i in range(rows):                                                │
│             # gold on current cell                                           │
│             right = dp if j < cols-1 else 0                                  │
│             right_up = dp if i > 0 and j < cols-1 else 0                     │
│             right_down = dp if i < rows-1 and j < cols-1 else 0              │
│             dp = grid + max(right, right_up, right_down)                     │
│                                                                              │
│     # max gold collected starting from any cell in first column              │
│     return max(dp[0] for i in range(rows))                                   │
│ ```                                                                          │
