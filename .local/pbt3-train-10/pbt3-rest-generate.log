│ def volume_tetrahedron(a, b, c, d):                                          │
│     """                                                                      │
│     Calculate the volume of a tetrahedron given its four vertices a, b, c,   │
│ d.                                                                           │
│                                                                              │
│     Each vertex should be an iterable of three coordinates (x, y, z).        │
│                                                                              │
│     Returns the volume if the tetrahedron is valid (non-degenerate),         │
│     otherwise returns 0.0.                                                   │
│                                                                              │
│     Parameters:                                                              │
│         a, b, c, d: iterable of length 3                                     │
│             Coordinates of the tetrahedron vertices.                         │
│                                                                              │
│     Returns:                                                                 │
│         float: Volume of the tetrahedron if valid, else 0.0.                 │
│     """                                                                      │
│     import math                                                              │
│                                                                              │
│     def vector_sub(u, v):                                                    │
│         return [u - v for i in range(3)]                                     │
│                                                                              │
│     def dot(u, v):                                                           │
│         return sum(u*v for i in range(3))                                    │
│                                                                              │
│     def cross(u, v):                                                         │
│         return [                                                             │
│             u[1]*v[2] - u[2]*v[1],                                           │
│             u[2]*v[0] - u[0]*v[2],                                           │
│             u[0]*v[1] - u[1]*v[0]                                            │
│         ]                                                                    │
│                                                                              │
│     # Convert inputs to lists of floats to ensure proper arithmetic          │
│     try:                                                                     │
│         a = list(map(float, a))                                              │
│         b = list(map(float, b))                                              │
│         c = list(map(float, c))                                              │
│         d = list(map(float, d))                                              │
│     except (TypeError, ValueError):                                          │
│         # Invalid input format                                               │
│         return 0.0                                                           │
│                                                                              │
│     if not (len(a) == len(b) == len(c) == len(d) == 3):                      │
│         return 0.0                                                           │
│                                                                              │
│     ab = vector_sub(b, a)                                                    │
│     ac = vector_sub(c, a)                                                    │
│     ad = vector_sub(d, a)                                                    │
│                                                                              │
│     cross_ac_ad = cross(ac, ad)                                              │
│     scalar_triple = dot(ab, cross_ac_ad)                                     │
│                                                                              │
│     volume = abs(scalar_triple) / 6.0                                        │
│                                                                              │
│     # Check for degenerate tetrahedron: volume must be positive and above a  │
│ small tolerance                                                              │
│     EPS = 1e-14                                                              │
│     if volume < EPS:                                                         │
│         return 0.0                                                           │
│                                                                              │
│     return volume                                                            │
