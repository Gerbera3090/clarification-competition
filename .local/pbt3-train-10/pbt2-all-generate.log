╭─────────────────────────────── Model Response ───────────────────────────────╮
│ ```python                                                                    │
│ def is_samepatterns(pattern, sequence):                                      │
│     if len(pattern) != len(sequence):                                        │
│         return False                                                         │
│                                                                              │
│     # Map each pattern character to the list of values it corresponds to     │
│     pattern_map = {}                                                         │
│     for p_char, val in zip(pattern, sequence):                               │
│         if p_char not in pattern_map:                                        │
│             pattern_map = []                                                 │
│         pattern_map.append(val)                                              │
│                                                                              │
│     # Check if all value lists for pattern characters have the same pattern  │
│     # We use the first pattern character's sequence as reference             │
│     ref_vals = pattern_map[pattern[0]]                                       │
│     for vals in pattern_map.values():                                        │
│         if len(vals) != len(ref_vals):                                       │
│             return False                                                     │
│         # Check if the relative pattern of equalities is the same            │
│         for i in range(len(vals)):                                           │
│             for j in range(i + 1, len(vals)):                                │
│                 if (vals == vals) != (ref_vals == ref_vals):                 │
│                     return False                                             │
│     return True                                                              │
│ ```                                                                          │
