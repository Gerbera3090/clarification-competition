╭─────────────────────────────── Model Response ───────────────────────────────╮
│ ```python                                                                    │
│ def get_maxgold(grid):                                                       │
│     if not grid or not grid[0]:                                              │
│         return 0                                                             │
│     n, m = len(grid), len(grid[0])                                           │
│     # dp: max gold collectible starting from cell (i,j)                      │
│     dp = [[0]*m for _ in range(n)]                                           │
│                                                                              │
│     for col in range(m-1, -1, -1):                                           │
│         for row in range(n):                                                 │
│             # gold collected from current cell                               │
│             gold_here = grid                                                 │
│             # if last column, no next step possible                          │
│             if col == m-1:                                                   │
│                 dp = gold_here                                               │
│             else:                                                            │
│                 # possible moves: right, right-up, right-down                │
│                 right = dp                                                   │
│                 right_up = dp if row > 0 else 0                              │
│                 right_down = dp if row < n-1 else 0                          │
│                 dp = gold_here + max(right, right_up, right_down)            │
│     # max gold collectible starting from any cell in first column            │
│     return max(dp[0] for row in range(n))                                    │
│ ```                                                                          │
