│ def total_match(lst1, lst2):                                                 │
│     '''                                                                      │
│     Writ a function that accepts two lists of strings and returns the list   │
│ that has                                                                     │
│     total number of chars in the all strings of the list less then the other │
│ list.                                                                        │
│                                                                              │
│     if the two lists have the same number of chars, return the first list.   │
│                                                                              │
│     Examples                                                                 │
