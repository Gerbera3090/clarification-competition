│     bell[0][0] = 1                                                           │
│                                                                              │
│     # Fill the bell triangle                                                 │
│     for i in range(1, n + 1):                                                │
│         for j in range(1, i + 1):                                            │
│             bell = bell + bell                                               │
│                                                                              │
│     # The Bell number for n is the value at bell[0]                          │
│     return bell[0]                                                           │
